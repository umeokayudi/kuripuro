{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": true
  },
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/sales?action=reminders", "schedule": "0 15 * * *" },
    { "path": "/api/sales?action=payroll-close", "schedule": "5 15 * * *" },
    { "path": "/api/sales?action=google-sync&op=cron", "schedule": "30 20 * * *" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] }
  ],
  "rewrites": [
    { "source": "/api/sales-ai", "destination": "/api/sales?route=ai" },
    { "source": "/api/sales-data", "destination": "/api/sales?route=data" },
    { "source": "/api/sales-files", "destination": "/api/sales?route=files" },
    { "source": "/api/sales-reminders", "destination": "/api/sales?route=reminders" },
    { "source": "/api/sales-session", "destination": "/api/sales?route=session" },
    { "source": "/api/calendar/:e/:t/kuripuro.ics", "destination": "/api/sales?route=calendar&e=:e&t=:t" },
    { "source": "/api/owner-view", "destination": "/api/sales?route=owner-view" },
    { "source": "/api/push", "destination": "/api/sales?route=push" },
    { "source": "/api/client-email", "destination": "/api/sales?route=client-email" },
    { "source": "/api/google/:op", "destination": "/api/sales?route=google&op=:op" },
    { "source": "/api/youtube/:op", "destination": "/api/sales?route=youtube&op=:op" },
    { "source": "/api/meetings", "destination": "/api/sales?route=meetings" },
    { "source": "/api/scan3d", "destination": "/api/sales?route=scan3d" },
    { "source": "/api/upload-photo", "destination": "/api/photo" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
