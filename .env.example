VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-side only (Vercel → Settings → Environment Variables)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Protects admin AI, schema setup, photo cleanup POST, analyze-reports (optional but recommended)
ADMIN_API_SECRET=generate-a-long-random-string
VITE_ADMIN_API_SECRET=same-value-as-ADMIN_API_SECRET

# CI only — never commit real passwords
TEST_PORTAL_USER=
TEST_PORTAL_PASSWORD=
